{
  "name": "shooter-game",
  "version": "0.1.0",
  "description": "A WebGPU shooter game built with Rust and Vite",
  "scripts": {
    "dev": "npm run build-wasm && vite",
    "build": "npm run build-wasm && vite build",
    "preview": "npm run build-wasm && vite preview",
    "build-wasm": "cd crates/game-client && wasm-pack build --target web --out-dir ../../pkg",
    "format": "prettier --write \"web/**/*.{js,css,html}\" \"*.ts\" \"*.js\"",
    "format:check": "prettier --check \"web/**/*.{js,css,html}\" \"*.ts\" \"*.js\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "web/**/*.{js,css,html}": [
      "prettier --write"
    ],
    "*.{js,ts}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-top-level-await": "^1.0.0",
    "vite-plugin-wasm": "^3.0.0"
  }
}
